# Ojo Spa Resorts — static site served at /ojo
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /ojo/404.html

# Hide the Git checkout Hostinger deploys from
RedirectMatch 404 /\.git

<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Fingerprinted Next.js assets never change
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
